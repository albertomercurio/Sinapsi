# Copy to .env.local (git-ignored) and fill in.
# Local development: values printed by `pnpm exec supabase status`.
# Production: Cloudflare → the Worker → Settings → Build → Variables (see docs/deployment.md);
# values from Supabase → Project settings → API keys / Data API.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=

# Region of the Supabase project (an EU one). Default: eu-west-1 (Ireland).
# VITE_SUPABASE_REGION=eu-west-1

# "true" only if Supabase can send e-mails: locally (Mailpit) or with custom SMTP in production.
# Otherwise invitations and new-password links are copied and delivered by the admin.
VITE_EMAIL_ENABLED=true
