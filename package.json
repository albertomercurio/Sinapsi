{
  "name": "sinapsi",
  "version": "0.1.0",
  "private": true,
  "description": "Piattaforma di stimolazione e riabilitazione cognitiva",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "vite",
    "build": "run-p typecheck \"build-only {@}\" --",
    "build-only": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:db": "supabase test db",
    "lint": "run-s lint:oxlint lint:eslint",
    "lint:oxlint": "oxlint .",
    "lint:eslint": "eslint . --cache",
    "format": "prettier --write src/ e2e/ scripts/",
    "i18n:check": "node --experimental-strip-types scripts/i18n-check.ts",
    "db:types": "supabase gen types typescript --local > src/shared/api/database.types.ts && prettier --write src/shared/api/database.types.ts",
    "fix": "oxlint . --fix && eslint . --fix --cache && prettier --write src/ e2e/ scripts/",
    "demo:seed": "SINAPSI_SEED_DEMO=1 vitest run scripts/seed-demo.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@lucide/vue": "^1.58.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/vue-query": "^5.104.3",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "fflate": "^0.8.3",
    "pinia": "^4.1.0",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.0",
    "vue": "^3.5.44",
    "vue-draggable-plus": "^0.6.1",
    "vue-i18n": "^11.4.14",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@intlify/message-compiler": "11.4.14",
    "@intlify/unplugin-vue-i18n": "^11.2.6",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.82.0",
    "eslint-plugin-playwright": "^2.12.0",
    "eslint-plugin-vue": "~10.11.0",
    "happy-dom": "^21.0.3",
    "jiti": "^2.7.0",
    "npm-run-all2": "^9.0.3",
    "otpauth": "^9.5.2",
    "oxlint": "~1.82.0",
    "prettier": "3.9.6",
    "supabase": "^2.121.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.0",
    "vite": "^8.3.4",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  },
  "engines": {
    "node": "^22.12.0 || >=24.12.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "supabase",
      "vue-demi"
    ]
  }
}
